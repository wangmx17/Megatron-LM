+def _log_hybridep_dispatch_token_counts(
+    routing_map: torch.Tensor,
+    group: torch.distributed.ProcessGroup,
+    num_local_experts: int,
+    num_experts: int,
+) -> None:
+    """统计并打印每次 dispatch 时从每个 rank 分到每个 rank 的 token 数量。routing_map 形状 [num_tokens, num_experts]，expert 按 rank 连续排列。"""
+    world_size = group.size()
+    rank_in_group = group.rank() if group is not None else 0
+    device = routing_map.device
+    # 本 rank 发往各 rank 的 token 数：rank r 拥有 expert 下标 [r*num_local_experts, (r+1)*num_local_experts)
+    send_counts = torch.zeros(world_size, dtype=torch.long, device=device)
+    for r in range(world_size):
+        start = r * num_local_experts
+        end = min((r + 1) * num_local_experts, num_experts)
+        if start < end:
+            send_counts[r] = (
+                routing_map[:, start:end].any(dim=1).sum(dtype=torch.long)
+            )
+    # all_gather 得到 [world_size, world_size]：行=src_rank，列=dst_rank
+    out_size = world_size * world_size
+    gathered = torch.zeros(out_size, dtype=torch.long, device=device)
+    torch.distributed.all_gather_into_tensor(
+        gathered, send_counts.contiguous(), group=group
+    )
+    matrix = gathered.view(world_size, world_size)
+    if rank_in_group == 0:
+        lines = ["[HybridEP dispatch] tokens sent: src_rank -> dst_rank (rows=src, cols=dst)"]
+        lines.append("     " + " ".join(f"r{k}" for k in range(world_size)))
+        for i in range(world_size):
+            lines.append("r{:2d}  {}".format(i, " ".join(str(matrix[i, j].item()) for j in range(world_size))))
+        logger.info("\n".join(lines))
+
+
